{
  "lexicon": 1,
  "id": "sh.mschf.ratking.defs",
  "description": "Draft phase-0 shared definitions. No public mailbox records. Policy and byte encodings are in design.md.",
  "defs": {
    "hpkeSuite": {
      "type": "object",
      "description": "RFC 9180 HPKE suite tuple using IANA numeric identifiers. Unknown suites validate structurally but require implementation support.",
      "required": [
        "kemId",
        "kdfId",
        "aeadId"
      ],
      "properties": {
        "kemId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "kdfId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "aeadId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "aad": {
      "type": "object",
      "description": "HPKE metadata. Canonical AAD binds envelope version, suite, enc and this object. See design.md.",
      "required": [
        "senderDid",
        "recipientDid",
        "messageId",
        "recipientKeyId"
      ],
      "properties": {
        "senderDid": {
          "type": "string",
          "format": "did"
        },
        "recipientDid": {
          "type": "string",
          "format": "did"
        },
        "messageId": {
          "type": "string",
          "format": "tid",
          "description": "Sender DID plus TID is the immutable idempotency key."
        },
        "recipientKeyId": {
          "type": "string",
          "format": "uri",
          "description": "DID URL of recipient's keyAgreement key; checked against recipientDid."
        },
        "expiresAt": {
          "type": "string",
          "format": "datetime",
          "description": "Absent means no expiry; never infer expiry from the TID."
        }
      }
    },
    "encryptedEnvelope": {
      "type": "object",
      "description": "Sign-then-encrypt envelope; appSignature over canonicalSigningBytes is encrypted inside ciphertext. Not an atproto record signature.",
      "required": [
        "version",
        "suite",
        "enc",
        "ciphertext",
        "aad"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "suite": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#hpkeSuite"
        },
        "enc": {
          "type": "bytes",
          "minLength": 1,
          "description": "HPKE encapsulated key, not a nonce."
        },
        "ciphertext": {
          "type": "bytes",
          "minLength": 1,
          "description": "HPKE encryption of signedMessage, including appSignature."
        },
        "aad": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#aad"
        }
      }
    },
    "deliveryState": {
      "type": "string",
      "knownValues": [
        "accepted",
        "queued",
        "delivered",
        "acked",
        "expired",
        "failed"
      ],
      "description": "Open values: accepted = durable admission; queued = awaiting runtime; delivered = injected into leased runtime, not processed; acked = recipient acknowledgment; expired = sender-set expiry reached; failed = terminal failure with a receipt. Unknown values are not success."
    },
    "messageRef": {
      "type": "object",
      "description": "Sender DID plus TID identity, with optional future repository locators.",
      "required": [
        "senderDid",
        "messageId"
      ],
      "properties": {
        "senderDid": {
          "type": "string",
          "format": "did"
        },
        "messageId": {
          "type": "string",
          "format": "tid"
        },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "Optional actual persisted record URI; never fabricate a phase-0 record locator."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "Optional CID of that exact persisted record, not a hash of JSON."
        }
      }
    },
    "appSignature": {
      "type": "object",
      "description": "App-specific encrypted signature over canonicalSigningBytes. Not a repo commit signature.",
      "required": [
        "algorithm",
        "keyId",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "knownValues": [
            "ES256",
            "ES256K"
          ]
        },
        "keyId": {
          "type": "string",
          "format": "uri",
          "description": "DID URL of sender's authorized signing key at send time."
        },
        "signature": {
          "type": "bytes"
        },
        "publicKeyMultibase": {
          "type": "string",
          "description": "Optional historical key hint, never authority without verified key history."
        }
      }
    },
    "signedMessage": {
      "type": "object",
      "description": "HPKE plaintext encoded as DRISL-CBOR. canonicalSigningBytes is the domain-separated canonical encoding of signingPayload, not JSON.",
      "required": [
        "canonicalSigningBytes",
        "appSignature"
      ],
      "properties": {
        "canonicalSigningBytes": {
          "type": "bytes"
        },
        "appSignature": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#appSignature"
        }
      }
    },
    "signingPayload": {
      "type": "object",
      "description": "Payload following the Rat King signature domain prefix. Metadata must match the envelope; body contains application bytes.",
      "required": [
        "version",
        "suite",
        "aad",
        "body"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "suite": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#hpkeSuite"
        },
        "aad": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#aad"
        },
        "body": {
          "type": "bytes"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "replyTo": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#messageRef"
        },
        "urgent": {
          "type": "boolean",
          "const": true,
          "description": "Sender asks to pierce the recipient's do-not-disturb. Signed and encrypted; recipients decide whom to honor. Absent means not urgent; false is not a valid encoding."
        }
      }
    },
    "didDocument": {
      "type": "object",
      "description": "Public DID document for create-only registration. Contains public EC P-256 verification keys only, never private key material.",
      "required": [
        "id",
        "verificationMethod",
        "authentication",
        "keyAgreement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "did"
        },
        "verificationMethod": {
          "type": "array",
          "items": { "type": "ref", "ref": "#didVerificationMethod" }
        },
        "authentication": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keyAgreement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "didVerificationMethod": {
      "type": "object",
      "required": ["id", "controller", "publicKeyJwk"],
      "properties": {
        "id": { "type": "string" },
        "controller": { "type": "string" },
        "publicKeyJwk": { "type": "ref", "ref": "#publicJwk" }
      }
    },
    "publicJwk": {
      "type": "object",
      "required": ["kty", "crv", "x", "y"],
      "properties": {
        "kty": { "type": "string", "const": "EC" },
        "crv": { "type": "string", "const": "P-256" },
        "x": { "type": "string" },
        "y": { "type": "string" }
      }
    },
    "birthContext": {
      "type": "object",
      "description": "Immutable serial birth context.",
      "required": [
        "operator",
        "project"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "description": "Public operator namespace label, not a private person name."
        },
        "project": {
          "type": "string",
          "description": "Public project namespace at birth, not the current assignment."
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "delegationReceipt": {
      "type": "object",
      "required": ["to"],
      "properties": {
        "to": { "type": "string" },
        "until": { "type": "string", "format": "datetime" }
      }
    },
    "receipt": {
      "type": "object",
      "description": "Sequenced receipt in the recipient's private log. State transitions append events, never overwrite history.",
      "required": [
        "message",
        "recipientDid",
        "state",
        "seq"
      ],
      "properties": {
        "delegated": { "type": "ref", "ref": "#delegationReceipt" },
        "delegatedTo": { "type": "string" },
        "delegatedFor": { "type": "string" },
        "originalId": { "type": "string", "format": "tid" },
        "message": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#messageRef"
        },
        "recipientDid": {
          "type": "string",
          "format": "did"
        },
        "state": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#deliveryState"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "recordedAt": {
          "type": "string",
          "format": "datetime"
        },
        "detail": {
          "type": "string",
          "description": "Optional public-safe failure or expiry explanation."
        },
        "woke": {
          "type": "boolean",
          "description": "Independent best-effort wake outcome, never proof of delivery."
        },
        "wakeReason": {
          "type": "string"
        },
        "resolvedFrom": {
          "type": "string",
          "maxLength": 128,
          "description": "The name the sender addressed when the issuer resolved it to this recipient through a role or a successor."
        },
        "via": {
          "type": "ref",
          "ref": "#via",
          "description": "Mailbox attestation for a desk-pass send: the verified desk, run and worker key, with the signed pass as evidence. Absent for ordinary sends."
        }
      }
    },
    "passRun": {
      "type": "string",
      "description": "Launcher-minted run handle '<label>:<id>'. The label is a lowercase agent label; the id is the worker's session UUID or 32 lowercase hex characters.",
      "maxLength": 69,
      "x-pattern": "^[a-z][a-z0-9_-]{0,31}:(?:[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "signedPass": {
      "type": "object",
      "description": "A desk-signed worker pass: base64url ES256 over DAG-CBOR {domain: 'sh.ratking.delegation.v1', record}.",
      "required": ["record", "signature"],
      "properties": {
        "record": { "type": "ref", "ref": "sh.ratking.pass" },
        "signature": { "type": "string", "x-pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "passIntent": {
      "type": "object",
      "description": "Worker-declared wake intent, signed inside the pass request.",
      "x-strict": true,
      "required": ["woke", "wakeReason"],
      "properties": {
        "woke": { "type": "boolean" },
        "wakeReason": { "type": "string", "enum": ["to", "quiet"] }
      }
    },
    "passRequest": {
      "type": "object",
      "description": "Worker-signed request. Signing bytes are DAG-CBOR {domain: 'sh.ratking.pass.request.v1', request}. Times are Unix seconds. Digests are base64url SHA-256.",
      "x-strict": true,
      "required": ["aud", "lxm", "iat", "exp", "jti", "envelopeDigest", "passDigest", "intent"],
      "properties": {
        "aud": { "type": "string", "description": "The mailbox service DID URL, such as <SERVICE_DID>#mailbox. ASCII only, so no two audiences share signing bytes.", "maxLength": 512, "x-pattern": "^did:[a-z]+:[A-Za-z0-9._:%-]+#[A-Za-z0-9._~-]+$" },
        "lxm": { "type": "string", "format": "nsid" },
        "iat": { "type": "integer", "minimum": 0 },
        "exp": { "type": "integer", "minimum": 0 },
        "jti": { "type": "string", "x-pattern": "^[A-Za-z0-9_-]{16,128}$" },
        "envelopeDigest": { "type": "string", "x-pattern": "^[A-Za-z0-9_-]{43}$" },
        "passDigest": { "type": "string", "x-pattern": "^[A-Za-z0-9_-]{43}$" },
        "intent": { "type": "ref", "ref": "#passIntent" }
      }
    },
    "via": {
      "type": "object",
      "description": "The mailbox verified this pass chain at admission: desk vouched for worker on run.",
      "required": ["desk", "deskDid", "run", "worker", "pass"],
      "properties": {
        "desk": { "type": "string", "minLength": 1, "maxLength": 256 },
        "deskDid": { "type": "string", "format": "did" },
        "run": { "type": "ref", "ref": "#passRun" },
        "worker": { "type": "string", "format": "did" },
        "pass": { "type": "ref", "ref": "#signedPass" }
      }
    },
    "messageEvent": {
      "type": "object",
      "description": "Message admission event; seq equals receipt.seq. Later transitions are separate receiptEvent objects.",
      "required": [
        "seq",
        "envelope",
        "receipt"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "envelope": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#encryptedEnvelope"
        },
        "receipt": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#receipt"
        }
      }
    },
    "receiptEvent": {
      "type": "object",
      "description": "Delivery transition event; seq equals receipt.seq.",
      "required": [
        "seq",
        "receipt"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "receipt": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#receipt"
        }
      }
    }
  }
}
