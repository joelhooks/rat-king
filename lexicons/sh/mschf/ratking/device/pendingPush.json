{
  "lexicon": 1,
  "id": "sh.mschf.ratking.device.pendingPush",
  "defs": {
    "main": {
      "type": "query",
      "description": "Operator-only notification projection for a recipient without a live lease. Do not log the result.",
      "parameters": {
        "type": "params",
        "required": [
          "recipientDid"
        ],
        "properties": {
          "recipientDid": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "notice": {
              "type": "ref",
              "ref": "#notice"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "MailboxUnavailable"
        }
      ]
    },
    "notice": {
      "type": "object",
      "required": [
        "admissionSeq",
        "body",
        "environment",
        "messageId",
        "title",
        "token"
      ],
      "properties": {
        "admissionSeq": {
          "type": "integer",
          "minimum": 1
        },
        "body": {
          "type": "string",
          "maxLength": 280
        },
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "messageId": {
          "type": "string",
          "format": "tid"
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "token": {
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
  }
}
