{
  "lexicon": 1,
  "id": "sh.mschf.ratking.identity.listNames",
  "defs": {
    "main": {
      "type": "query",
      "description": "Authenticated directory of issued names, ordered by name. Retired names are hidden by default. Live and idle filters inspect mailbox leases with a bounded scan and a rolling limit of 500 reads per authenticated caller per 10 minutes. Short pages can carry a continuation cursor.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": { "type": "string", "maxLength": 128 },
          "all": { "type": "boolean" },
          "match": { "type": "string", "maxLength": 128 },
          "status": { "type": "string", "maxLength": 32, "x-pattern": "^(?:live|idle|retired)(?:,(?:live|idle|retired))*$" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["names"],
          "properties": {
            "names": {
              "type": "array",
              "maxLength": 100,
              "items": { "type": "ref", "ref": "#entry" }
            },
            "cursor": { "type": "string", "maxLength": 128 },
            "scanned": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "errors": [
        { "name": "InvalidRequest" },
        { "name": "AuthRequired" },
        { "name": "MailboxUnavailable" },
        { "name": "ScanBudgetSpent", "description": "HTTP 429. Use ratking snapshot for inventory or look up a single named row." }
      ]
    },
    "parent": {
      "type": "object",
      "required": ["name", "session"],
      "properties": {
        "name": { "type": "string", "maxLength": 128, "x-pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*/)?[a-z][a-z0-9_-]{0,31}$" },
        "session": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "required": ["name", "did", "document"],
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "parent": { "type": "ref", "ref": "#parent" },
        "status": { "type": "string", "enum": ["live", "idle", "retired"] },
        "roleTarget": { "type": "boolean" },
        "did": { "type": "string", "format": "did" },
        "document": { "type": "ref", "ref": "sh.mschf.ratking.defs#didDocument" }
      }
    }
  }
}
