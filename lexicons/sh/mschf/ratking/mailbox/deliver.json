{
  "lexicon": 1,
  "id": "sh.mschf.ratking.mailbox.deliver",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "States are accepted → delivered → acked. Mark injection into the recipient runtime, not processing. Requires the recipient's current leaseId and generation fence; a stale fence is refused, never ignored. Idempotent from delivered, returning the original delivery receipt.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "message",
            "recipientDid",
            "leaseId",
            "generation"
          ],
          "properties": {
            "message": {
              "type": "ref",
              "ref": "sh.mschf.ratking.defs#messageRef"
            },
            "recipientDid": {
              "type": "string",
              "format": "did"
            },
            "leaseId": {
              "type": "string",
              "format": "tid"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "receipt"
          ],
          "properties": {
            "receipt": {
              "type": "ref",
              "ref": "sh.mschf.ratking.defs#receipt"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "MessageNotFound"
        },
        {
          "name": "LeaseMismatch"
        },
        {
          "name": "InvalidTransition"
        }
      ]
    }
  }
}
