{
  "lexicon": 1,
  "id": "sh.mschf.ratking.mailbox.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read recipient's private sequenced log in ascending order without mutation. Opaque cursor paginates a bounded snapshot; afterSeq starts a new incremental snapshot.",
      "parameters": {
        "type": "params",
        "required": [
          "recipientDid"
        ],
        "properties": {
          "recipientDid": {
            "type": "string",
            "format": "did"
          },
          "cursor": {
            "type": "string",
            "description": "Opaque snapshot cursor; keep all other parameters fixed while paginating."
          },
          "afterSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "description": "throughSeq is a constant watermark across all pages in this snapshot.",
          "required": [
            "events",
            "throughSeq"
          ],
          "properties": {
            "events": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "union",
                "refs": [
                  "sh.mschf.ratking.defs#messageEvent",
                  "sh.mschf.ratking.defs#receiptEvent"
                ],
                "closed": false
              }
            },
            "throughSeq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cursor": {
              "type": "string",
              "description": "Present only while more entries remain. Checkpoint throughSeq after processing every page."
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "Invalid or unsupported operation."
        },
        {
          "name": "AuthRequired",
          "description": "Missing or invalid service-auth token."
        },
        {
          "name": "Forbidden",
          "description": "Authenticated DID is not authorized."
        },
        {
          "name": "InvalidCursor",
          "description": "Malformed, wrong-recipient, unsupported-version or future cursor."
        },
        {
          "name": "CursorExpired",
          "description": "Cannot resume; no silent skipping. Restart from the last processed sequence."
        }
      ]
    }
  }
}
