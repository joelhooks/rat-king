{
  "lexicon": 1,
  "id": "sh.mschf.ratking.mailbox.listPage",
  "defs": {
    "main": {
      "type": "query",
      "description": "Owner-only mailbox page. With afterSeq, return forward log events. Otherwise return the newest admissions and their current receipts, with optional exclusive beforeSeq.",
      "parameters": {
        "type": "params",
        "required": [
          "recipientDid"
        ],
        "properties": {
          "recipientDid": {
            "type": "string",
            "format": "did"
          },
          "afterSeq": {
            "type": "integer",
            "minimum": 0
          },
          "beforeSeq": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "events",
            "latestSeq"
          ],
          "properties": {
            "events": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "union",
                "refs": [
                  "sh.mschf.ratking.defs#messageEvent",
                  "sh.mschf.ratking.defs#receiptEvent",
                  "sh.mschf.ratking.attention.receipt"
                ],
                "closed": false
              }
            },
            "latestSeq": {
              "type": "integer",
              "minimum": 0
            },
            "messages": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#message"
              }
            },
            "nextAfterSeq": {
              "type": "integer",
              "minimum": 1
            },
            "nextBeforeSeq": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "MailboxUnavailable"
        },
        {
          "name": "InvalidCursor"
        }
      ]
    },
    "message": {
      "type": "object",
      "required": [
        "admissionSeq",
        "envelope",
        "receipt"
      ],
      "properties": {
        "admissionSeq": {
          "type": "integer",
          "minimum": 1
        },
        "envelope": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#encryptedEnvelope"
        },
        "receipt": {
          "type": "ref",
          "ref": "sh.mschf.ratking.defs#receipt"
        }
      }
    }
  }
}
