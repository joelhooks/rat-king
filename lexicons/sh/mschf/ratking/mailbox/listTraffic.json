{
  "lexicon": 1,
  "id": "sh.mschf.ratking.mailbox.listTraffic",
  "defs": {
    "main": {
      "type": "query",
      "description": "Observer or operator journal: metadata, plus the body of signed plaintext messages. Global seq orders journal ingestion, recipientSeq orders each mailbox. Captures events after feed activation; time is mailbox observation time. Cursor is an exclusive global sequence; repeat it to follow. No recipient fan-out.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "events",
            "cursor"
          ],
          "properties": {
            "criticalCounts": { "type": "array", "maxLength": 100, "items": { "type": "ref", "ref": "#criticalCount" } },
            "events": {
              "type": "array",
              "maxLength": 100,
              "items": {
                "type": "ref",
                "ref": "#entry"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "InvalidCursor"
        },
        {
          "name": "MailboxUnavailable"
        }
      ]
    },
    "criticalCount": {
      "type": "object",
      "required": ["senderDid", "day", "count"],
      "properties": {
        "senderDid": { "type": "string", "format": "did" },
        "day": { "type": "string" },
        "count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "via": {
      "type": "object",
      "required": ["desk", "deskDid", "run"],
      "properties": {
        "desk": { "type": "string", "minLength": 1, "maxLength": 256 },
        "deskDid": { "type": "string", "format": "did" },
        "run": { "type": "ref", "ref": "sh.mschf.ratking.defs#passRun" }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "seq",
        "recipientSeq",
        "time",
        "senderDid",
        "recipientDid",
        "messageId",
        "ciphertextSize",
        "state"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "recipientSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "time": {
          "type": "string",
          "format": "datetime"
        },
        "senderDid": {
          "type": "string",
          "format": "did"
        },
        "recipientDid": {
          "type": "string",
          "format": "did"
        },
        "messageId": {
          "type": "string",
          "format": "tid"
        },
        "ciphertextSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "body": {
          "type": "string",
          "description": "UTF-8 body of a signed plaintext message, verified at admission. Absent for encrypted messages."
        },
        "resolvedFrom": {
          "type": "string",
          "maxLength": 128,
          "description": "The name the sender addressed, when it resolved to this recipient through a role or a successor."
        },
        "via": {
          "type": "ref",
          "ref": "#via",
          "description": "Present when a worker sent under its desk's pass. Readers show the desk as the sender."
        },
        "state": {
          "type": "string",
          "knownValues": [
            "accepted",
            "queued",
            "delivered",
            "acked",
            "expired",
            "failed"
          ]
        }
      }
    }
  }
}
