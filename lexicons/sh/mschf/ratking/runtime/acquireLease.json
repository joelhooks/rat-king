{
  "lexicon": 1,
  "id": "sh.mschf.ratking.runtime.acquireLease",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Exclusive per DID. A signed request from the same DID with the current leaseId and generation may hand over to a new harness session, fencing the old holder. Otherwise a live lease returns LeaseHeld. Server clamps expiresAt to at most 5 minutes ahead.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "did",
            "harness",
            "expiresAt"
          ],
          "properties": {
            "leaseId": { "type": "string", "format": "tid" },
            "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "did": {
              "type": "string",
              "format": "did"
            },
            "harness": {
              "type": "union",
              "refs": [
                "sh.mschf.ratking.runtime.lease#pi",
                "sh.mschf.ratking.runtime.lease#claude",
                "sh.mschf.ratking.runtime.lease#codex",
                "sh.mschf.ratking.runtime.lease#opencode",
                "sh.mschf.ratking.runtime.lease#other"
              ],
              "closed": false
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "lease"
          ],
          "properties": {
            "lease": {
              "type": "ref",
              "ref": "sh.mschf.ratking.runtime.lease"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest"
        },
        {
          "name": "AuthRequired"
        },
        {
          "name": "Forbidden"
        },
        {
          "name": "LeaseHeld"
        }
      ]
    }
  }
}
