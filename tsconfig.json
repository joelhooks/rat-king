{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "*.config.ts",
    "scripts/*.ts",
    "tools/oxlint/**/*.ts",
    "tools/fence/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".agent_sources",
    ".agent-sources",
    ".turbo"
  ]
}
